    "@types/nodemailer": "8.0.0",
    "@types/pg": "8.20.0",
    "@types/pino": "7.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
