{
  "name": "bilinear",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "yarn db:generate && next build",
    "postinstall": "yarn db:generate",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:tokens:update": "node scripts/check-design-tokens.mjs --update",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:infra": "docker compose -f docker-compose.infra.yml",
    "docker:infra:up": "run docker:infra up -d",
    "docker:infra:down": "run docker:infra down",
    "db:generate": "DATABASE_URL=dummy prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify:indexes": "node scripts/benchmark-indexes.mjs",
    "db:verify:fence": "node scripts/verify-xid8-fence.mjs",
    "db:verify:config": "tsx --env-file-if-exists=.env scripts/verify-config.ts",
    "db:verify:schema": "node scripts/verify-schema.mjs",
    "admin:grant": "tsx --env-file-if-exists=.env scripts/grant-platform-admin.ts",
    "ws:server": "tsx --env-file-if-exists=.env src/server/ws/index.ts",
    "yjs:server": "tsx --env-file-if-exists=.env src/server/yjs/index.ts",
    "analyze": "ANALYZE=true next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/next": "4.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hocuspocus/provider": "4.6.0",
    "@hocuspocus/server": "4.6.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.3.3",
    "@sentry/nextjs": "10.73.0",
    "@tanstack/react-virtual": "3.14.10",
    "@tiptap/extension-character-count": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@tiptap/y-tiptap": "3.0.9",
    "@xmldom/xmldom": "0.8.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dataloader": "2.2.3",
    "date-fns": "4.4.0",
    "dexie": "4.4.5",
    "dotenv": "17.4.2",
    "graphql": "16.14.2",
    "graphql-depth-limit": "1.1.0",
    "graphql-query-complexity": "1.1.1",
    "graphql-scalars": "1.26.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "lowlight": "3.3.0",
    "lucide-react": "1.41.0",
    "mermaid": "11.17.2",
    "mobx": "6.16.1",
