{
  "name": "issue-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:tokens:update": "node scripts/check-design-tokens.mjs --update",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:infra": "docker compose -f docker-compose.infra.yml",
    "docker:infra:up": "run docker:infra up -d",
    "docker:infra:down": "run docker:infra down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "admin:grant": "tsx --env-file-if-exists=.env scripts/grant-platform-admin.ts",
    "ws:server": "tsx --env-file-if-exists=.env src/server/ws/index.ts",
    "yjs:server": "tsx --env-file-if-exists=.env src/server/yjs/index.ts",
    "analyze": "ANALYZE=true next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@apollo/server": "5.5.0",
    "@as-integrations/next": "4.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hocuspocus/provider": "4.1.0",
    "@hocuspocus/server": "4.1.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-slot": "1.2.4",
    "@sentry/nextjs": "10.50.0",
    "@tanstack/react-virtual": "3.13.24",
    "@tiptap/extension-character-count": "3.22.4",
    "@tiptap/extension-code-block": "3.22.4",
    "@tiptap/extension-code-block-lowlight": "3.22.4",
    "@tiptap/extension-collaboration": "3.22.4",
    "@tiptap/extension-collaboration-cursor": "3.0.0",
    "@tiptap/extension-color": "3.22.4",
    "@tiptap/extension-highlight": "3.22.4",
    "@tiptap/extension-horizontal-rule": "3.22.4",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extension-link": "3.22.4",
    "@tiptap/extension-mention": "3.22.4",
    "@tiptap/extension-placeholder": "3.22.4",
    "@tiptap/extension-table": "3.22.4",
    "@tiptap/extension-table-cell": "3.22.4",
    "@tiptap/extension-table-header": "3.22.4",
    "@tiptap/extension-table-row": "3.22.4",
    "@tiptap/extension-task-item": "3.22.4",
    "@tiptap/extension-task-list": "3.22.4",
    "@tiptap/extension-text-style": "3.22.4",
    "@tiptap/extension-underline": "3.22.4",
    "@tiptap/extensions": "3.22.4",
    "@tiptap/pm": "3.22.4",
    "@tiptap/react": "3.22.4",
    "@tiptap/starter-kit": "3.22.4",
    "@tiptap/suggestion": "3.22.4",
    "@tiptap/y-tiptap": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dataloader": "2.2.3",
    "date-fns": "4.1.0",
    "dexie": "4.4.2",
    "dotenv": "17.4.2",
    "graphql": "16.13.2",
    "graphql-depth-limit": "1.1.0",
    "graphql-query-complexity": "1.1.0",
    "graphql-scalars": "1.25.0",
    "graphql-tag": "2.12.6",
    "highlight.js": "11.11.1",
    "ioredis": "5.10.1",
    "jose": "6.2.2",
    "lowlight": "3.3.0",
    "lucide-react": "1.11.0",
    "mermaid": "11.14.0",
    "mobx": "6.15.0",
    "mobx-react-lite": "4.1.1",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "nodemailer": "8.0.6",
