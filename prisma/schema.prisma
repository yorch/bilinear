enum CustomFieldType {
  text
  number
  date
  select
  multi_select
  url
  checkbox

  @@map("custom_field_type")
}

/// Team-scoped custom field definition.
/// `options` holds `[{ value, label, color? }]` for select/multi_select types;
/// null for other types.
model CustomFieldDefinition {
  id          String          @id @default(uuid()) @db.Uuid
  teamId      String          @map("team_id") @db.Uuid
  name        String          @db.VarChar(255)
  type        CustomFieldType
  description String?
  required    Boolean         @default(false)
  options     Json?
  sortOrder   Float           @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz

  team   Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@index([teamId])
  @@map("custom_field_definitions")
}

/// One row per (issueId, definitionId) holding the typed JSON value.
/// Value shape by type: text/url → string, number → number, date → ISO date string,
/// checkbox → boolean, select → string (option value), multi_select → string[].
model CustomFieldValue {
  id           String   @id @default(uuid()) @db.Uuid
  issueId      String   @map("issue_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  value        Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  issue      Issue                 @relation(fields: [issueId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([issueId, definitionId])
  @@index([issueId])
  @@index([definitionId])
  @@map("custom_field_values")
}

