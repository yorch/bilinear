generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @db.VarChar(255)
  urlKey     String  @unique @map("url_key") @db.VarChar(63)
  logoUrl    String? @map("logo_url")
  dataRegion String  @default("US") @map("data_region") @db.VarChar(2)

  roadmapEnabled     Boolean @default(false) @map("roadmap_enabled")
  customersEnabled   Boolean @default(false) @map("customers_enabled")
  initiativesEnabled Boolean @default(false) @map("initiatives_enabled")

  securitySettings Json  @default("{}") @map("security_settings")
  authSettings     Json  @default("{}") @map("auth_settings")
  themeSettings    Json? @map("theme_settings")

  fiscalYearStartMonth Int @default(1) @map("fiscal_year_start_month")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  members        OrganizationMember[]
  teams          Team[]
  issues         Issue[]
  labels         IssueLabel[]
  notifications  Notification[]
  syncActions    SyncAction[]
  projects       Project[]
  cycles         Cycle[]
  customViews    CustomView[]
  documents      Document[]
  publicRoadmap       PublicRoadmap?
  initiatives         Initiative[]
  webhooks               Webhook[]
  githubIntegration      GitHubIntegration?
  githubPullRequests     GitHubPullRequest[]
  favorites              Favorite[]
  customFieldDefinitions CustomFieldDefinition[]
  automationRules        AutomationRule[]

  @@map("organizations")
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(255)
  displayName   String  @map("display_name") @db.VarChar(255)
  email         String  @unique @db.VarChar(255)
  initials      String  @db.VarChar(4)
  avatarUrl     String? @map("avatar_url")
  avatarBgColor String  @default("#6366f1") @map("avatar_bg_color") @db.VarChar(7)

  active   Boolean   @default(true)
  lastSeen DateTime? @map("last_seen") @db.Timestamptz
  timezone String?   @db.VarChar(63)

  statusEmoji   String?   @map("status_emoji") @db.VarChar(32)
  statusLabel   String?   @map("status_label") @db.VarChar(255)
  statusUntilAt DateTime? @map("status_until_at") @db.Timestamptz

  passwordHash String? @map("password_hash")
  googleId     String? @unique @map("google_id") @db.VarChar(255)

  emailNotificationsEnabled Boolean @default(true) @map("email_notifications_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  orgMemberships            OrganizationMember[]
  authTokens                AuthToken[]
  teamMemberships           TeamMembership[]
  assignedIssues            Issue[]                    @relation("AssignedIssues")
  createdIssues             Issue[]                    @relation("CreatedIssues")
  snoozedIssues             Issue[]                    @relation("SnoozedIssues")
  createdLabels             IssueLabel[]               @relation("CreatedLabels")
  projectsLed               Project[]                  @relation("ProjectLead")
  projectsCreated           Project[]                  @relation("ProjectCreator")
  projectMemberships        ProjectMember[]
  projectUpdates            ProjectUpdate[]
  customViews               CustomView[]               @relation("CreatedViews")
  issueActivities           IssueActivity[]            @relation("ActivityActor")
  notificationSubscriptions NotificationSubscription[]
  receivedNotifications     Notification[]             @relation("ReceivedNotifications")
  sentNotifications         Notification[]             @relation("SentNotifications")
  createdDocuments          Document[]                 @relation("CreatedDocuments")
  createdTemplates          IssueTemplate[]            @relation("CreatedTemplates")
  comments                  Comment[]                  @relation("AuthoredComments")
  resolvedComments          Comment[]                  @relation("ResolvedComments")
  commentReactions          CommentReaction[]
  issueReactions            IssueReaction[]
  teamMemberRoles           TeamMemberRole[]
  ownedInitiatives          Initiative[]               @relation("InitiativeOwner")
  createdInitiatives        Initiative[]               @relation("InitiativeCreator")
  initiativeUpdates         InitiativeUpdate[]         @relation("InitiativeUpdateAuthor")
  createdWebhooks           Webhook[]                  @relation("WebhookCreator")
  githubIntegrations        GitHubIntegration[]        @relation("GitHubIntegrationCreator")
  favorites                 Favorite[]

  @@map("users")
}

model OrganizationMember {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  // owner, admin, member, guest
  role           String @default("member") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model AuthToken {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  // magic_link, refresh, api_key
  type      String  @db.VarChar(20)
  // tokenHash carries a partial UNIQUE constraint enforced in SQL (see
  // 20260512100000_db_hardening_constraints) covering `type = 'refresh'`
  // only. Magic-link rows hash a 6-digit code whose 1M-value space
  // makes cross-user hash collisions expected, so they are deliberately
  // excluded. Prisma cannot model partial unique indexes, so the
  // constraint lives in the migration only.
  tokenHash String  @map("token_hash")
  // 6-digit code for magic link
  code      String? @db.VarChar(6)

  // Groups refresh tokens issued from a single initial login. If any token
  // in the family is replayed after revocation (outside the rotation grace
  // window), the entire family is revoked — classic refresh-token reuse
  // detection. Nullable so tokens issued before the 2026-04-22 migration
  // continue to refresh individually until they naturally expire.
  familyId  String? @map("family_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  label     String? @db.VarChar(255)
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The single `(token_hash)` index from the init migration was replaced
  // with two type-partitioned indexes in
  // 20260512100000_db_hardening_constraints: a partial UNIQUE for
  // `type = 'refresh'` and a partial non-unique for `type =
  // 'magic_link'`. Both live in SQL only because Prisma cannot model
  // partial indexes.
  @@index([familyId])
  @@map("auth_tokens")
}

model Team {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  key            String  @db.VarChar(10)
  displayName    String  @map("display_name") @db.VarChar(255)
  description    String?
  icon           String? @db.VarChar(255)
  color          String? @db.VarChar(7)
  private        Boolean @default(false)

  // Hierarchy
  parentId String? @map("parent_id") @db.Uuid

  // Timezone
  timezone String @default("UTC") @db.VarChar(63)

  // Cycle configuration (used in Sprint 15-16)
  cyclesEnabled            Boolean @default(false) @map("cycles_enabled")
  cycleDuration            Int?    @default(2) @map("cycle_duration")
  cycleCooldownTime        Int?    @default(0) @map("cycle_cooldown_time")
  cycleStartDay            Int?    @default(1) @map("cycle_start_day")
  cycleLockToActive        Boolean @default(false) @map("cycle_lock_to_active")
  cycleAutoAssignStarted   Boolean @default(false) @map("cycle_auto_assign_started")
  cycleAutoAssignCompleted Boolean @default(false) @map("cycle_auto_assign_completed")

  // Auto-close/archive
  autoClosePeriod       Int?    @map("auto_close_period")
  autoCloseStateId      String? @map("auto_close_state_id") @db.Uuid
  autoArchivePeriod     Int?    @map("auto_archive_period")
  autoCloseChildIssues  Boolean @default(false) @map("auto_close_child_issues")
  autoCloseParentIssues Boolean @default(false) @map("auto_close_parent_issues")

  // Estimation
  issueEstimationType      String  @default("notUsed") @map("issue_estimation_type") @db.VarChar(20)
  issueEstimationExtended  Boolean @default(false) @map("issue_estimation_extended")
  issueEstimationAllowZero Boolean @default(false) @map("issue_estimation_allow_zero")
  defaultIssueEstimate     Float?  @map("default_issue_estimate")

  // Defaults
  defaultIssueStateId String? @map("default_issue_state_id") @db.Uuid
  triageEnabled       Boolean @default(false) @map("triage_enabled")

  // Counter
  issueCount Int @default(0) @map("issue_count")

  // Lifecycle
  joinByDefault Boolean   @default(false) @map("join_by_default")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                 Team?                   @relation("TeamHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Team[]                  @relation("TeamHierarchy")
  memberships            TeamMembership[]
  workflowStates         WorkflowState[]         @relation("TeamWorkflowStates")
  defaultIssueState      WorkflowState?          @relation("TeamDefaultIssueState", fields: [defaultIssueStateId], references: [id], onDelete: SetNull)
  autoCloseState         WorkflowState?          @relation("TeamAutoCloseState", fields: [autoCloseStateId], references: [id], onDelete: SetNull)
  issues                 Issue[]
  labels                 IssueLabel[]
  projectTeams           ProjectTeam[]
  cycles                 Cycle[]
  customViews            CustomView[]
  issueTemplates         IssueTemplate[]
  memberRoles            TeamMemberRole[]
  customFieldDefinitions CustomFieldDefinition[]
  documents              Document[]
  automationRules        AutomationRule[]

  // Unique on (organizationId, key) is enforced via a partial index in the DB
  // (WHERE archived_at IS NULL) so archived teams don't block key reuse.
  @@index([organizationId, key])
  @@index([organizationId])
  @@index([parentId])
  // Index the FK referencing columns so deletes/updates of a WorkflowState
  // don't seq-scan teams to find dependents. Without these, PG falls back
  // to a full table scan on every workflow_states delete (which the FK's
  // ON DELETE SET NULL has to evaluate).
  @@index([defaultIssueStateId])
  @@index([autoCloseStateId])
  @@map("teams")
}

model TeamMembership {
  id        String  @id @default(uuid()) @db.Uuid
  teamId    String  @map("team_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  isOwner   Boolean @default(false) @map("is_owner")
  sortOrder Float   @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_memberships")
}

model WorkflowState {
  id          String  @id @default(uuid()) @db.Uuid
  teamId      String  @map("team_id") @db.Uuid
  name        String  @db.VarChar(255)
  color       String  @db.VarChar(7)
  description String?
  type        String  @db.VarChar(20)
  position    Float   @default(0)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  team              Team    @relation("TeamWorkflowStates", fields: [teamId], references: [id], onDelete: Cascade)
  issues            Issue[]
  defaultForTeams   Team[]  @relation("TeamDefaultIssueState")
  autoCloseForTeams Team[]  @relation("TeamAutoCloseState")

  @@index([teamId])
  @@index([teamId, type])
  @@map("workflow_states")
}

model Issue {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  teamId              String   @map("team_id") @db.Uuid
  number              Int
  identifier          String   @db.VarChar(20)
  previousIdentifiers String[] @default([]) @map("previous_identifiers")

  // Content
  title            String  @db.VarChar(1000)
  description      String?
  descriptionState Bytes?  @map("description_state")

  // Properties
  priority          Int       @default(0) @db.SmallInt
  estimate          Float?
  startDate         DateTime? @map("start_date") @db.Date
  dueDate           DateTime? @map("due_date") @db.Date
  sortOrder         Float     @default(0) @map("sort_order")
  prioritySortOrder Float     @default(0) @map("priority_sort_order")
  subIssueSortOrder Float?    @map("sub_issue_sort_order")

  // Relationships
  stateId            String  @map("state_id") @db.Uuid
  assigneeId         String? @map("assignee_id") @db.Uuid
  creatorId          String? @map("creator_id") @db.Uuid
  parentId           String? @map("parent_id") @db.Uuid
  projectId          String? @map("project_id") @db.Uuid
  projectMilestoneId String? @map("project_milestone_id") @db.Uuid
  cycleId            String? @map("cycle_id") @db.Uuid

  // Git
  branchName String? @map("branch_name") @db.VarChar(500)

  // SLA
  slaBreachesAt   DateTime? @map("sla_breaches_at") @db.Timestamptz
  slaHighRiskAt   DateTime? @map("sla_high_risk_at") @db.Timestamptz
  slaMediumRiskAt DateTime? @map("sla_medium_risk_at") @db.Timestamptz
  slaStartedAt    DateTime? @map("sla_started_at") @db.Timestamptz
  slaType         String?   @map("sla_type") @db.VarChar(50)

  // Lifecycle timestamps
  startedAt        DateTime? @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  canceledAt       DateTime? @map("canceled_at") @db.Timestamptz
  autoArchivedAt   DateTime? @map("auto_archived_at") @db.Timestamptz
  autoClosedAt     DateTime? @map("auto_closed_at") @db.Timestamptz
  startedTriageAt  DateTime? @map("started_triage_at") @db.Timestamptz
  triagedAt        DateTime? @map("triaged_at") @db.Timestamptz
  addedToCycleAt   DateTime? @map("added_to_cycle_at") @db.Timestamptz
  addedToProjectAt DateTime? @map("added_to_project_at") @db.Timestamptz

  // Soft delete / snooze
  trashed        Boolean   @default(false)
  snoozedById    String?   @map("snoozed_by_id") @db.Uuid
  snoozedUntilAt DateTime? @map("snoozed_until_at") @db.Timestamptz

  // Metadata
  reactionData        Json @default("{}") @map("reaction_data")
  customerTicketCount Int  @default(0) @map("customer_ticket_count")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  organization      Organization               @relation(fields: [organizationId], references: [id])
  team              Team                       @relation(fields: [teamId], references: [id])
  state             WorkflowState              @relation(fields: [stateId], references: [id])
  assignee          User?                      @relation("AssignedIssues", fields: [assigneeId], references: [id])
  creator           User?                      @relation("CreatedIssues", fields: [creatorId], references: [id])
  snoozedBy         User?                      @relation("SnoozedIssues", fields: [snoozedById], references: [id])
  parent            Issue?                     @relation("SubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children          Issue[]                    @relation("SubIssues")
  labelAssignments  IssueLabelAssignment[]
  activities        IssueActivity[]
  cycle             Cycle?                     @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  project           Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectMilestone  ProjectMilestone?          @relation(fields: [projectMilestoneId], references: [id], onDelete: SetNull)
  subscriptions     NotificationSubscription[]
  issueRelations    IssueRelation[]            @relation("IssueRelations")
  relatedToIssues   IssueRelation[]            @relation("RelatedIssues")
  files             File[]
  comments          Comment[]
  customFieldValues CustomFieldValue[]
  pullRequests      GitHubPullRequest[]
  reactions         IssueReaction[]

  @@unique([teamId, number])
  @@index([organizationId])
  @@index([teamId])
  @@index([stateId])
  @@index([assigneeId])
  @@index([projectId])
  @@index([cycleId])
  @@index([parentId])
  @@index([identifier])
  @@index([teamId, priority])
  @@index([teamId, createdAt])
  @@index([updatedAt])
  // GIN index over the previous-identifier history array. Currently
  // unused — `IssueService.findByIdentifier` only matches on the live
  // `identifier` column. The index ships ahead of a planned change
  // that will fall back to a `previousIdentifiers` lookup so renamed
  // issues stay reachable by their old key (e.g. a team-key change
  // moving ENG-123 → PLAT-123). Cheap to maintain in the meantime;
  // writes to `previousIdentifiers` happen only on team-key renames.
  @@index([previousIdentifiers], type: Gin)
  @@map("issues")
}

model IssueLabel {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  teamId         String? @map("team_id") @db.Uuid
  name           String  @db.VarChar(255)
  color          String  @db.VarChar(7)
  description    String?

  isGroup  Boolean @default(false) @map("is_group")
  parentId String? @map("parent_id") @db.Uuid

  creatorId     String?   @map("creator_id") @db.Uuid
  lastAppliedAt DateTime? @map("last_applied_at") @db.Timestamptz

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  organization Organization           @relation(fields: [organizationId], references: [id])
  team         Team?                  @relation(fields: [teamId], references: [id])
  parent       IssueLabel?            @relation("LabelHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     IssueLabel[]           @relation("LabelHierarchy")
  creator      User?                  @relation("CreatedLabels", fields: [creatorId], references: [id])
  assignments  IssueLabelAssignment[]

  @@index([organizationId])
  @@index([teamId])
  @@index([parentId])
  @@map("issue_labels")
}

model SyncAction {
  id             BigInt @id @default(autoincrement())
  organizationId String @map("organization_id") @db.Uuid
  // I=Insert, U=Update, D=Delete, A=Archive
  action         String @db.VarChar(1)
  modelName      String @map("model_name") @db.VarChar(50)
  modelId        String @map("model_id") @db.Uuid
  data           Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  // Statement-time timestamp set at COMMIT inside a trigger
  // (`set_sync_action_committed_at`). Delta-sync orders by `committedAt`
  // and ignores rows newer than `now() - SAFETY_WINDOW_MS` so a slow
  // commit cannot leave a gap in the sequence — without this, BIGSERIAL
  // ids can commit out of order and a client that records lastSyncId=N
  // would silently skip an earlier-id-but-later-commit row. See
  // `SyncService.getDeltaSyncActions`.
  committedAt DateTime @default(now()) @map("committed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, id])
  @@index([organizationId, committedAt, id])
  @@index([createdAt])
  @@map("sync_actions")
}

model Project {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  slugId         String  @map("slug_id") @db.VarChar(255)
  description    String  @default("")
  content        String?
  icon           String? @db.VarChar(255)
  color          String  @default("#6366f1") @db.VarChar(7)

  statusType      String    @default("planned") @map("status_type") @db.VarChar(20)
  statusName      String?   @map("status_name") @db.VarChar(255)
  health          String?   @db.VarChar(20)
  healthUpdatedAt DateTime? @map("health_updated_at") @db.Timestamptz

  priority          Int   @default(0) @db.SmallInt
  prioritySortOrder Float @default(0) @map("priority_sort_order")

  progress Float @default(0)
  scope    Float @default(0)

  startDate            DateTime? @map("start_date") @db.Date
  targetDate           DateTime? @map("target_date") @db.Date
  startDateResolution  String?   @map("start_date_resolution") @db.VarChar(20)
  targetDateResolution String?   @map("target_date_resolution") @db.VarChar(20)

  leadId    String? @map("lead_id") @db.Uuid
  creatorId String? @map("creator_id") @db.Uuid

  completedIssueCountHistory Json @default("[]") @map("completed_issue_count_history")
  completedScopeHistory      Json @default("[]") @map("completed_scope_history")
  issueCountHistory          Json @default("[]") @map("issue_count_history")
  scopeHistory               Json @default("[]") @map("scope_history")

  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  canceledAt     DateTime? @map("canceled_at") @db.Timestamptz
  autoArchivedAt DateTime? @map("auto_archived_at") @db.Timestamptz
  trashed        Boolean   @default(false)
  roadmapVisible Boolean   @default(false) @map("roadmap_visible")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         User?               @relation("ProjectLead", fields: [leadId], references: [id])
  creator      User?               @relation("ProjectCreator", fields: [creatorId], references: [id])
  teams        ProjectTeam[]
  members      ProjectMember[]
  issues       Issue[]
  milestones   ProjectMilestone[]
  updates      ProjectUpdate[]
  documents    Document[]
  initiatives  InitiativeProject[]
  files        File[]

  @@unique([organizationId, slugId])
  @@index([organizationId])
  @@index([statusType])
  @@index([leadId])
  @@map("projects")
}

model ProjectTeam {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
  @@map("project_teams")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  targetDate  DateTime? @map("target_date") @db.Date
  sortOrder   Float     @default(0) @map("sort_order")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

