  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // admin, member, guest
  role      String   @default("member") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_member_roles")
}

model PublicRoadmap {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @unique @map("organization_id") @db.Uuid
  slug           String  @unique @db.VarChar(63)
  enabled        Boolean @default(false)
  title          String  @db.VarChar(255)
  description    String?
  passwordHash   String? @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@map("public_roadmaps")
}

model Document {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  teamId         String?   @map("team_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  creatorId      String?   @map("creator_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  title          String    @db.VarChar(255)
  content        String?
  contentState   Bytes?    @map("content_state")
  icon           String?   @db.VarChar(255)
  sortOrder      Float     @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator      User?        @relation("CreatedDocuments", fields: [creatorId], references: [id], onDelete: SetNull)
  parent       Document?    @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Document[]   @relation("DocumentHierarchy")

  @@index([organizationId])
  @@index([teamId])
  @@index([projectId])
  @@index([parentId])
  @@map("documents")
}

/// Top-level strategic planning object that groups one or more projects
/// to track a multi-quarter goal. Progress rolls up from associated
/// projects (issue-completion average).
model Initiative {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  description    String?
  icon           String? @db.VarChar(255)
  color          String  @default("#6366f1") @db.VarChar(7)

  // planned, active, completed, canceled
  status            String  @default("planned") @db.VarChar(20)
  priority          Int     @default(0) @db.SmallInt
  prioritySortOrder Float   @default(0) @map("priority_sort_order")
  sortOrder         Float   @default(0) @map("sort_order")

  // Quarter or date-range targets
  targetDate           DateTime? @map("target_date") @db.Date
  startDate            DateTime? @map("start_date") @db.Date
  startDateResolution  String?   @map("start_date_resolution") @db.VarChar(20)
  targetDateResolution String?   @map("target_date_resolution") @db.VarChar(20)

  ownerId   String? @map("owner_id") @db.Uuid
  creatorId String? @map("creator_id") @db.Uuid

  // Hierarchy — sub-initiatives nest under a parent for large strategic
  // trees. Max depth is enforced in the service layer (5 levels) so the
  // UI breadcrumb stays readable. SetNull on parent delete re-roots
  // orphans rather than cascading the delete.
  parentId String? @map("parent_id") @db.Uuid

  // Cached roll-up — recomputed when projects change
  progress Float @default(0)

  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  canceledAt  DateTime? @map("canceled_at") @db.Timestamptz

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?               @relation("InitiativeOwner", fields: [ownerId], references: [id])
  creator      User?               @relation("InitiativeCreator", fields: [creatorId], references: [id])
  parent       Initiative?         @relation("InitiativeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Initiative[]        @relation("InitiativeHierarchy")
  projects     InitiativeProject[]
  updates      InitiativeUpdate[]

  @@index([organizationId])
  @@index([status])
  @@index([ownerId])
  @@index([parentId])
  @@map("initiatives")
}

/// Status update on an initiative (status report style). Mirrors ProjectUpdate
/// for use in the initiative detail timeline.
model InitiativeUpdate {
  id           String    @id @default(uuid()) @db.Uuid
  initiativeId String    @map("initiative_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  body         String
  bodyData     Json      @map("body_data")
  health       String    @db.VarChar(20)
  editedAt     DateTime? @map("edited_at") @db.Timestamptz

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  user       User       @relation("InitiativeUpdateAuthor", fields: [userId], references: [id])

  @@index([initiativeId])
  @@map("initiative_updates")
}

/// Many-to-many join: each row associates a Project to an Initiative.
/// A project can belong to multiple initiatives (rare but supported by Linear).
model InitiativeProject {
  id           String   @id @default(uuid()) @db.Uuid
  initiativeId String   @map("initiative_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  sortOrder    Float    @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, projectId])
  @@index([initiativeId])
  @@index([projectId])
  @@map("initiative_projects")
}

/// Outbound HTTP webhook subscription. Events from `events` are POSTed to
/// `url` with a HMAC SHA-256 signature header (`X-Bilinear-Signature`)
/// computed from the raw request body using `signingSecret`. Deliveries
/// are recorded in WebhookDelivery and retried with exponential backoff.
model Webhook {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  url            String  @db.VarChar(2000)
  // Array of subscribed event names: "issue.created", "issue.updated",
  // "comment.created", "project.updated", etc. See WEBHOOK_EVENTS in
  // src/server/services/webhook.service.ts for the full list.
  events         String[] @default([])
  signingSecret  String  @map("signing_secret")
  enabled        Boolean @default(true)
  // teamId scopes events to a single team — null = org-wide.
  teamId         String? @map("team_id") @db.Uuid

  // Health metrics
  lastDeliveryAt    DateTime? @map("last_delivery_at") @db.Timestamptz
  lastSuccessAt     DateTime? @map("last_success_at") @db.Timestamptz
  consecutiveFailures Int     @default(0) @map("consecutive_failures")

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  // Cascade, not SetNull: `teamId = null` means "org-wide", so nulling it when a
  // team is deleted would silently broaden a team-scoped webhook to the whole org.
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("webhooks")
}

/// Single attempt to deliver a webhook event. Status is one of "pending",
/// "in_flight", "success", or "failed". A worker transitions a row from
/// `pending` to `in_flight` atomically before sending the HTTP request,
/// so two concurrent workers can't both deliver the same event. Failed
/// deliveries are retried up to 5 times with exponential backoff; the
/// final attempt sets status="failed".
model WebhookDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  webhookId String   @map("webhook_id") @db.Uuid
  event     String   @db.VarChar(50)
  payload   Json
  // pending, in_flight, success, failed
  status    String   @default("pending") @db.VarChar(10)
  attempts  Int      @default(0)
  // Last response status code; null until the first attempt completes.
  responseStatus Int?    @map("response_status")
  responseBody   String? @map("response_body")
  errorMessage   String? @map("error_message")

  // Next retry timestamp; null when status != pending.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Pin an entity (issue, project, initiative, view, cycle, document, team)
/// to the user's sidebar. One row per (user, entity_type, entity_id);
/// `sortOrder` controls vertical position within the Favorites section.
/// Org-scoped so a workspace switch clears the favorites view; cleanup of
/// stale entityId references is the responsibility of the read path
/// (resolvers filter out missing/wrong-org targets via DataLoader).
model Favorite {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Issue | Project | Initiative | CustomView | Cycle | Document | Team
  entityType     String   @map("entity_type") @db.VarChar(20)
  entityId       String   @map("entity_id") @db.Uuid
  sortOrder      Float    @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId], map: "favorites_user_entity_uniq")
  @@index([userId])
  @@index([organizationId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// GitHub Integration
// ---------------------------------------------------------------------------

model GitHubIntegration {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  // OAuth access token for making GitHub API calls on behalf of the connector.
  // Stored in plaintext for now; encrypt at rest in a follow-up hardening pass.
  accessToken  String @map("access_token") @db.VarChar(500)
  // GitHub login (user or org) that connected the integration
  githubLogin  String @map("github_login") @db.VarChar(255)
  githubUserId Int    @map("github_user_id")

  // HMAC-SHA256 secret shared with the GitHub webhook configuration.
  // Set by the user in their GitHub org/repo webhook settings.
  webhookSecret String @map("webhook_secret") @db.VarChar(255)

  createdById String @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("GitHubIntegrationCreator", fields: [createdById], references: [id])
  pullRequests GitHubPullRequest[]

  @@map("github_integrations")
}

model GitHubPullRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  issueId        String @map("issue_id") @db.Uuid
  integrationId  String @map("integration_id") @db.Uuid

  // GitHub PR data
  prNumber     Int    @map("pr_number")
  title        String @db.VarChar(500)
  url          String @db.VarChar(1000)
  // open | closed | merged
  state        String @db.VarChar(20)
  draft        Boolean @default(false)
  headBranch   String  @map("head_branch") @db.VarChar(500)
  repoFullName String  @map("repo_full_name") @db.VarChar(500)
  // GitHub user login who opened the PR
  authorLogin  String @map("author_login") @db.VarChar(255)

  mergedAt DateTime? @map("merged_at") @db.Timestamptz
  closedAt DateTime? @map("closed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  issue        Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  integration  GitHubIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, prNumber, repoFullName, issueId], map: "github_pull_requests_pr_issue_uniq")
  @@index([issueId])
  @@index([organizationId])
  @@map("github_pull_requests")
}

/// Slack workspace integration — one per org. Powers the /bilinear slash
/// command (create issues from Slack). The bot access token is per-install;
/// slash-request signatures are verified with the app-level SLACK_SIGNING_SECRET.
model SlackIntegration {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  // Slack workspace (team) this install belongs to. Unique so a Slack
  // workspace maps to exactly one org; slash commands route by this id.
  slackTeamId   String @unique @map("slack_team_id") @db.VarChar(64)
  slackTeamName String @map("slack_team_name") @db.VarChar(255)

  // Bot access token (xoxb-…) for chat.postMessage etc. Plaintext for now;
  // encrypt at rest in a follow-up hardening pass (same as GitHub token).
  accessToken String @map("access_token") @db.VarChar(500)
  botUserId   String @map("bot_user_id") @db.VarChar(64)

  // Bilinear team that slash-command issues are filed into. Nullable until an
  // admin picks one; slash commands without it return a helpful error.
  defaultTeamId String? @map("default_team_id") @db.Uuid

  createdById String @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // SetNull: losing the default team must not uninstall the integration; the
  // slash command falls back to prompting for a team.
  defaultTeam Team? @relation("SlackDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)

  @@map("slack_integrations")
}

/// Rule-based automation. Triggers fire on resolver events (issue_created,
/// issue_state_changed, etc.) and execute one or more actions if the rule's
/// optional condition predicate evaluates to true. Rules are evaluated
/// fire-and-forget from the issue / comment resolvers; failures are logged
/// but never block the originating mutation.
///
/// triggerConfig / actionConfig shapes live in
/// src/server/services/automation.service.ts and are documented there.
model AutomationRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  // teamId scopes the rule to a single team; null = workspace-wide. The
  // service layer enforces tenant guards on either side.
  teamId         String? @map("team_id") @db.Uuid

  name        String  @db.VarChar(255)
  description String?

  // Trigger: event name that fires this rule. See TRIGGER_TYPES in the
  // automation service for the enumerable set.
  triggerType   String                  @map("trigger_type") @db.VarChar(50)
  // JSONB config interpreted per trigger type (e.g. for issue_state_changed,
  // { fromCategory?: string, toCategory?: string }).
  triggerConfig Json                    @default("{}") @map("trigger_config")

  // Optional filter predicate evaluated before actions run. JSON-encoded
  // tree of { field, op, value } leaves; same shape as IssueFilter.
  conditions    Json?                   @map("conditions")

  // One or more actions executed in array order. Each action carries its
  // own type + config. See ACTION_TYPES in the automation service.
  actions       Json                    @default("[]") @map("actions")

  enabled       Boolean                 @default(true)
  // Higher sortOrder runs first. Lets admins prioritize rules.
  sortOrder     Float                   @default(0) @map("sort_order")
  // Statistics for the admin UI — purely informational.
  lastRunAt     DateTime?               @map("last_run_at") @db.Timestamptz
  runCount      Int                     @default(0) @map("run_count")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Match the referential integrity of sibling created_by columns
  // (webhooks, github_integrations): a real FK that nulls out when the
  // author's user row is deleted, rather than a dangling id with no FK.
  createdBy    User?        @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, enabled])
  @@index([teamId, enabled])
  @@index([triggerType])
  @@map("automation_rules")
}

/// Append-only security-relevant event log. Each row captures who did what,
/// when, from where. Free for self-hosted deployments (§3.3, PRD §3.4).
/// Partitioned by createdAt for long-term retention; hard-deletes are never
/// issued — rows expire via a scheduled vacuum or pg_partman in production.
model AuditLogEntry {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  userId         String? @map("user_id") @db.Uuid

  /// Event category and name, e.g. "auth.login", "issue.delete", "member.role_changed"
  action       String  @db.VarChar(100)
  resourceType String? @map("resource_type") @db.VarChar(50)
  resourceId   String? @map("resource_id") @db.VarChar(36)

  /// Arbitrary JSON context for the action (old/new values, etc.)
  metadata Json?

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@map("audit_log_entries")
}

/// SP-initiated SAML 2.0 configuration for an organisation (one per org).
/// Free for self-hosted deployments per PRD §3.4.
model SamlConfiguration {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @unique @map("organization_id") @db.Uuid

  /// IDP metadata URL — fetched on demand to refresh signing certs
  idpMetadataUrl String? @map("idp_metadata_url") @db.VarChar(1000)
  /// Raw IDP metadata XML — used when URL is not available
  idpMetadataXml String? @map("idp_metadata_xml") @db.Text
  /// Required: IDP SSO POST endpoint
  idpSsoUrl      String  @default("") @map("idp_sso_url") @db.VarChar(1000)
  /// Required: IDP entity ID / issuer
  idpEntityId    String  @default("") @map("idp_entity_id") @db.VarChar(500)
  /// IDP X.509 signing certificate (PEM format, including -----BEGIN CERTIFICATE----- header/footer)
  idpCert        String  @default("") @map("idp_cert") @db.Text

  /// Attribute name in SAML assertion that maps to user email
  emailAttribute String @default("email") @map("email_attribute") @db.VarChar(255)
  /// Attribute name for display name (optional)
  nameAttribute  String @default("name") @map("name_attribute") @db.VarChar(255)

  /// Enable JIT provisioning — auto-create user on first SSO login
  jitProvisioning Boolean @default(true) @map("jit_provisioning")
  /// When true, only SSO logins are allowed (magic link / password disabled)
  ssoEnforced     Boolean @default(false) @map("sso_enforced")

  enabled     Boolean @default(false)
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("SamlConfigCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("saml_configurations")
}

/// Bearer token for SCIM 2.0 provisioning API. Tokens are stored hashed
/// (SHA-256 hex). The plaintext is only shown once on creation.
/// Free for self-hosted deployments per PRD §3.4.
model ScimToken {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid

  /// SHA-256(plaintext_token) — 64 hex chars
  tokenHash  String  @unique @map("token_hash") @db.VarChar(64)
  /// Human-readable label
  label      String  @db.VarChar(255)
  createdById String? @map("created_by_id") @db.Uuid

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ScimTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("scim_tokens")
}

/// A pending invitation to join an organization. The raw token only ever
/// exists in the invitation email — the row stores SHA-256(token), matching
/// how `AuthToken` handles magic-link codes and `ScimToken` handles API
/// tokens, so a database compromise yields no usable invitations.
///
/// Deliberately *not* uniquely constrained on `(organizationId, email)`:
/// re-inviting someone after a revoked or expired invitation is normal, and
/// a plain unique index would forbid it while a partial one (pending rows
/// only) is inexpressible in Prisma. `OrganizationInviteService.create`
/// revokes any outstanding invitation for the pair before issuing a new one
/// — the same revoke-then-issue pattern `AuthService.sendMagicLink` uses.
model OrganizationInvite {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Lowercased at write time; acceptance requires the accepting session's
  /// email to match, so an invitation link is not bearer-usable by whoever
  /// happens to receive a forwarded email.
  email String @db.VarChar(255)
  /// Org role granted on acceptance.
  role  OrganizationRole @default(member)

  /// SHA-256(plaintext_token) — 64 hex chars
  tokenHash   String  @unique @map("token_hash") @db.VarChar(64)
  invitedById String? @map("invited_by_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  /// Set when claimed. Non-null means spent — invitations are single-use.
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  /// Who claimed it. May differ from nothing in practice (acceptance
  /// requires an email match) but is recorded so the audit trail doesn't
  /// depend on re-resolving the email later.
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteCreator", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  // No standalone [organizationId] index: it would be a strict prefix of the
  // composite below, which Postgres already serves org-only lookups from.
  @@index([organizationId, email])
  @@map("organization_invites")
}
