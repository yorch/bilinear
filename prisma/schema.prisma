/// Outbound HTTP webhook subscription. Events from `events` are POSTed to
/// `url` with a HMAC SHA-256 signature header (`X-Bilinear-Signature`)
/// computed from the raw request body using `signingSecret`. Deliveries
/// are recorded in WebhookDelivery and retried with exponential backoff.
model Webhook {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  url            String  @db.VarChar(2000)
  // Array of subscribed event names: "issue.created", "issue.updated",
  // "comment.created", "project.updated", etc. See WEBHOOK_EVENTS in
  // src/server/services/webhook.service.ts for the full list.
  events         String[] @default([])
  signingSecret  String  @map("signing_secret")
  enabled        Boolean @default(true)
  // teamId scopes events to a single team — null = org-wide.
  teamId         String? @map("team_id") @db.Uuid

  // Health metrics
  lastDeliveryAt    DateTime? @map("last_delivery_at") @db.Timestamptz
  lastSuccessAt     DateTime? @map("last_success_at") @db.Timestamptz
  consecutiveFailures Int     @default(0) @map("consecutive_failures")

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("webhooks")
}

/// Single attempt to deliver a webhook event. Status is one of "pending",
/// "in_flight", "success", or "failed". A worker transitions a row from
/// `pending` to `in_flight` atomically before sending the HTTP request,
/// so two concurrent workers can't both deliver the same event. Failed
/// deliveries are retried up to 5 times with exponential backoff; the
/// final attempt sets status="failed".
model WebhookDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  webhookId String   @map("webhook_id") @db.Uuid
  event     String   @db.VarChar(50)
  payload   Json
  // pending, in_flight, success, failed
  status    String   @default("pending") @db.VarChar(10)
  attempts  Int      @default(0)
  // Last response status code; null until the first attempt completes.
  responseStatus Int?    @map("response_status")
  responseBody   String? @map("response_body")
  errorMessage   String? @map("error_message")

  // Next retry timestamp; null when status != pending.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Pin an entity (issue, project, initiative, view, cycle, document, team)
/// to the user's sidebar. One row per (user, entity_type, entity_id);
/// `sortOrder` controls vertical position within the Favorites section.
/// Org-scoped so a workspace switch clears the favorites view; cleanup of
/// stale entityId references is the responsibility of the read path
/// (resolvers filter out missing/wrong-org targets via DataLoader).
model Favorite {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Issue | Project | Initiative | CustomView | Cycle | Document | Team
  entityType     String   @map("entity_type") @db.VarChar(20)
  entityId       String   @map("entity_id") @db.Uuid
  sortOrder      Float    @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId], map: "favorites_user_entity_uniq")
  @@index([userId])
  @@index([organizationId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// GitHub Integration
// ---------------------------------------------------------------------------

model GitHubIntegration {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  // OAuth access token for making GitHub API calls on behalf of the connector.
  // Stored in plaintext for now; encrypt at rest in a follow-up hardening pass.
  accessToken  String @map("access_token") @db.VarChar(500)
  // GitHub login (user or org) that connected the integration
  githubLogin  String @map("github_login") @db.VarChar(255)
  githubUserId Int    @map("github_user_id")

  // HMAC-SHA256 secret shared with the GitHub webhook configuration.
  // Set by the user in their GitHub org/repo webhook settings.
  webhookSecret String @map("webhook_secret") @db.VarChar(255)

  createdById String @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("GitHubIntegrationCreator", fields: [createdById], references: [id])
  pullRequests GitHubPullRequest[]

  @@map("github_integrations")
}

model GitHubPullRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  issueId        String @map("issue_id") @db.Uuid
  integrationId  String @map("integration_id") @db.Uuid

  // GitHub PR data
  prNumber     Int    @map("pr_number")
  title        String @db.VarChar(500)
  url          String @db.VarChar(1000)
  // open | closed | merged
  state        String @db.VarChar(20)
  draft        Boolean @default(false)
  headBranch   String  @map("head_branch") @db.VarChar(500)
  repoFullName String  @map("repo_full_name") @db.VarChar(500)
  // GitHub user login who opened the PR
  authorLogin  String @map("author_login") @db.VarChar(255)

  mergedAt DateTime? @map("merged_at") @db.Timestamptz
  closedAt DateTime? @map("closed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  issue        Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  integration  GitHubIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, prNumber, repoFullName, issueId], map: "github_pull_requests_pr_issue_uniq")
  @@index([issueId])
  @@index([organizationId])
  @@map("github_pull_requests")
}

/// Rule-based automation. Triggers fire on resolver events (issue_created,
/// issue_state_changed, etc.) and execute one or more actions if the rule's
/// optional condition predicate evaluates to true. Rules are evaluated
/// fire-and-forget from the issue / comment resolvers; failures are logged
/// but never block the originating mutation.
///
/// triggerConfig / actionConfig shapes live in
/// src/server/services/automation.service.ts and are documented there.
model AutomationRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  // teamId scopes the rule to a single team; null = workspace-wide. The
  // service layer enforces tenant guards on either side.
  teamId         String? @map("team_id") @db.Uuid

  name        String  @db.VarChar(255)
  description String?

  // Trigger: event name that fires this rule. See TRIGGER_TYPES in the
  // automation service for the enumerable set.
  triggerType   String                  @map("trigger_type") @db.VarChar(50)
  // JSONB config interpreted per trigger type (e.g. for issue_state_changed,
  // { fromCategory?: string, toCategory?: string }).
  triggerConfig Json                    @default("{}") @map("trigger_config")

  // Optional filter predicate evaluated before actions run. JSON-encoded
  // tree of { field, op, value } leaves; same shape as IssueFilter.
  conditions    Json?                   @map("conditions")

  // One or more actions executed in array order. Each action carries its
  // own type + config. See ACTION_TYPES in the automation service.
  actions       Json                    @default("[]") @map("actions")

  enabled       Boolean                 @default(true)
  // Higher sortOrder runs first. Lets admins prioritize rules.
  sortOrder     Float                   @default(0) @map("sort_order")
  // Statistics for the admin UI — purely informational.
  lastRunAt     DateTime?               @map("last_run_at") @db.Timestamptz
  runCount      Int                     @default(0) @map("run_count")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
  @@index([teamId, enabled])
  @@index([triggerType])
  @@map("automation_rules")
}
