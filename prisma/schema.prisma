generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @db.VarChar(255)
  urlKey     String  @unique @map("url_key") @db.VarChar(63)
  logoUrl    String? @map("logo_url")
  dataRegion String  @default("US") @map("data_region") @db.VarChar(2)

  roadmapEnabled     Boolean @default(false) @map("roadmap_enabled")
  customersEnabled   Boolean @default(false) @map("customers_enabled")
  initiativesEnabled Boolean @default(false) @map("initiatives_enabled")
  // Gates the AI assistant features (title suggestion, summarize, duplicate
  // detection). Also requires ANTHROPIC_API_KEY to be set server-side.
  aiEnabled          Boolean @default(false) @map("ai_enabled")

  securitySettings Json  @default("{}") @map("security_settings")
  authSettings     Json  @default("{}") @map("auth_settings")
  themeSettings    Json? @map("theme_settings")

  fiscalYearStartMonth Int @default(1) @map("fiscal_year_start_month")

  // Plan-tier caps. Defaults match the previously-hardcoded constants they
  // replace (see custom-field.service.ts, label.service.ts,
  // initiative.service.ts, import.service.ts) — data-driven so a future
  // admin UI can raise/lower them per org without a code change. Until that
  // UI ships, these are only settable directly in the DB.
  maxCustomFieldsPerTeam Int @default(20) @map("max_custom_fields_per_team")
  maxCustomFieldsPerOrg  Int @default(30) @map("max_custom_fields_per_org")
  maxLabelGroupChildren  Int @default(250) @map("max_label_group_children")
  maxInitiativeDepth     Int @default(5) @map("max_initiative_depth")
  maxExportRows          Int @default(10000) @map("max_export_rows")

  // Platform-admin suspension. Distinct from `archivedAt` (soft-delete): a
  // suspended org is locked (members can't authenticate into it) but not
  // deleted, so it can be restored. Set/cleared only from the /admin console.
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz
  suspendedReason String?   @map("suspended_reason")

  // High-water mark of the sync_actions retention sweep: the highest `xact_id`
  // the sweep has deleted for this org. A delta cursor at or below it provably
  // cannot be caught up (the rows between are gone), so the client is told to
  // re-bootstrap instead of being served a silently incomplete page.
  //
  // Kept in xid8 space, not wall-clock, because that is what the delta cursor
  // is keyed on — the sweep itself prunes by `created_at`, but the *mark* has
  // to be comparable against a cursor. Numeric rather than BigInt because xid8
  // is unsigned 64-bit and would overflow a signed int8 at the top of its
  // range. Null means nothing has ever been pruned — the common case.
  syncActionsPrunedThroughXactId Decimal? @map("sync_actions_pruned_through_xact_id") @db.Decimal(20, 0)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  members        OrganizationMember[]
  teams          Team[]
  issues         Issue[]
  labels         IssueLabel[]
  notifications  Notification[]
  syncActions    SyncAction[]
  projects       Project[]
  cycles         Cycle[]
  customViews    CustomView[]
  documents      Document[]
  publicRoadmap       PublicRoadmap?
  initiatives         Initiative[]
  webhooks               Webhook[]
  githubIntegration      GitHubIntegration?
  githubPullRequests     GitHubPullRequest[]
  slackIntegration       SlackIntegration?
  favorites              Favorite[]
  customFieldDefinitions CustomFieldDefinition[]
  automationRules        AutomationRule[]
  auditLogEntries        AuditLogEntry[]
  samlConfiguration      SamlConfiguration?
  scimTokens             ScimToken[]
  authTokens             AuthToken[]
  invites                OrganizationInvite[]

  @@map("organizations")
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(255)
  displayName   String  @map("display_name") @db.VarChar(255)
  email         String  @unique @db.VarChar(255)
  initials      String  @db.VarChar(4)
  avatarUrl     String? @map("avatar_url")
  avatarBgColor String  @default("#6366f1") @map("avatar_bg_color") @db.VarChar(7)

  active   Boolean   @default(true)
  lastSeen DateTime? @map("last_seen") @db.Timestamptz
  timezone String?   @db.VarChar(63)

  statusEmoji   String?   @map("status_emoji") @db.VarChar(32)
  statusLabel   String?   @map("status_label") @db.VarChar(255)
  statusUntilAt DateTime? @map("status_until_at") @db.Timestamptz

  passwordHash String? @map("password_hash")
  googleId     String? @unique @map("google_id") @db.VarChar(255)
  githubId     String? @unique @map("github_id") @db.VarChar(255)

  emailNotificationsEnabled Boolean @default(true) @map("email_notifications_enabled")

  // Persisted UI/email language preference (app locale, e.g. "en" / "es").
  // Written when the user switches language; null = never set -> fall back to
  // the visitor's Accept-Language, then the app default. Read in two places:
  // server-side to localize transactional emails, which have no access to the
  // browser's locale cookie, and by the session route, which seeds that cookie
  // at login so the language follows the account to a new browser or device
  // (the same treatment `accent` gets below).
  locale String? @db.VarChar(10)

  // Persisted accent-colour preference (see src/lib/accent.ts). Unlike `locale`
  // this has no server-side renderer that needs it — the running app reads the
  // `accent` cookie, which the root layout stamps onto <html> during SSR. It is
  // stored so the preference follows the account to a new browser or device:
  // the session route seeds the cookie from this column at login, which is the
  // only place it is read. Null = never chosen -> the default accent.
  accent String? @db.VarChar(20)

  // Cross-tenant platform operator. Grants access to the /admin console
  // (tenant + user management, impersonation, platform metrics). Independent
  // of org/team roles — this is a global privilege, not org-scoped. The first
  // user created in an empty deployment is bootstrapped to true; thereafter
  // existing platform admins grant/revoke it via the console.
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")

  calendarFeedToken String? @unique @map("calendar_feed_token") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  orgMemberships            OrganizationMember[]
  authTokens                AuthToken[]
  teamMemberships           TeamMembership[]
  assignedIssues            Issue[]                    @relation("AssignedIssues")
  createdIssues             Issue[]                    @relation("CreatedIssues")
  snoozedIssues             Issue[]                    @relation("SnoozedIssues")
  createdLabels             IssueLabel[]               @relation("CreatedLabels")
  projectsLed               Project[]                  @relation("ProjectLead")
  projectsCreated           Project[]                  @relation("ProjectCreator")
  projectMemberships        ProjectMember[]
  projectUpdates            ProjectUpdate[]
  customViews               CustomView[]               @relation("CreatedViews")
  issueActivities           IssueActivity[]            @relation("ActivityActor")
  notificationSubscriptions NotificationSubscription[]
  receivedNotifications     Notification[]             @relation("ReceivedNotifications")
  sentNotifications         Notification[]             @relation("SentNotifications")
  createdDocuments          Document[]                 @relation("CreatedDocuments")
  createdTemplates          IssueTemplate[]            @relation("CreatedTemplates")
  comments                  Comment[]                  @relation("AuthoredComments")
  resolvedComments          Comment[]                  @relation("ResolvedComments")
  commentReactions          CommentReaction[]
  issueReactions            IssueReaction[]
  teamMemberRoles           TeamMemberRole[]
  ownedInitiatives          Initiative[]               @relation("InitiativeOwner")
  createdInitiatives        Initiative[]               @relation("InitiativeCreator")
  initiativeUpdates         InitiativeUpdate[]         @relation("InitiativeUpdateAuthor")
  createdWebhooks           Webhook[]                  @relation("WebhookCreator")
  githubIntegrations        GitHubIntegration[]        @relation("GitHubIntegrationCreator")
  createdAutomationRules    AutomationRule[]           @relation("AutomationRuleCreator")
  favorites                 Favorite[]
  auditLogEntries           AuditLogEntry[]            @relation("AuditLogUser")
  createdSamlConfigurations SamlConfiguration[]        @relation("SamlConfigCreator")
  createdScimTokens         ScimToken[]                @relation("ScimTokenCreator")
  platformAuditLogs         PlatformAuditLog[]         @relation("PlatformAuditActor")
  sentInvites               OrganizationInvite[]       @relation("InviteCreator")
  acceptedInvites           OrganizationInvite[]       @relation("InviteAcceptor")
  uploadedFiles             File[]                     @relation("UploadedFiles")

  @@map("users")
}

model OrganizationMember {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  role           OrganizationRole @default(member)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

/// Write-once audit trail for platform-admin (cross-tenant) actions. Kept
/// separate from `AuditLogEntry` because platform actions are not scoped to a
/// single organization — the actor operates above any one tenant. `actorId`
/// is nullable + SetNull so deleting an admin never erases the trail; the
/// `targetType`/`targetId` pair points at whatever was acted on (an org, a
/// user, …).
model PlatformAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(32)
  targetId   String?  @map("target_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("PlatformAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@map("platform_audit_logs")
}

model AuthToken {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  // magic_link, refresh, api_key
  type      String  @db.VarChar(20)

  // The organization an `api_key` row acts against, stamped from the session
  // that created it. Only meaningful for `type = 'api_key'` — magic-link and
  // refresh tokens identify a *user*, and the org they resolve to is decided
  // at access-token issue time (see AuthService.issueTokenPair).
  //
  // Required for multi-org accounts: without it, API-key auth had to guess an
  // org, and `extractAuthContext` guessed the user's oldest membership — so a
  // key created while working in org B silently operated on org A. Nullable
  // because a key whose org membership is later revoked keeps the row (the
  // key simply stops resolving an org and fails auth) and because non-api_key
  // rows never set it.
  organizationId String? @map("organization_id") @db.Uuid
  // tokenHash carries a partial UNIQUE constraint enforced in SQL (see
  // 20260512100000_db_hardening_constraints) covering `type = 'refresh'`
  // only. Magic-link rows hash a 6-digit code whose 1M-value space
  // makes cross-user hash collisions expected, so they are deliberately
  // excluded. Prisma cannot model partial unique indexes, so the
  // constraint lives in the migration only.
  tokenHash String  @map("token_hash")
  // 6-digit code for magic link
  code      String? @db.VarChar(6)

  // Groups refresh tokens issued from a single initial login. If any token
  // in the family is replayed after revocation (outside the rotation grace
  // window), the entire family is revoked — classic refresh-token reuse
  // detection. Nullable so tokens issued before the 2026-04-22 migration
  // continue to refresh individually until they naturally expire.
  familyId  String? @map("family_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  label     String? @db.VarChar(255)
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent")

  // Permission scopes for `type = 'api_key'` rows. Empty = full access
  // (legacy keys created before scopes existed). Recognised values: `read`,
  // `write`. Enforced centrally in the GraphQL route: a key lacking `write`
  // is rejected on any mutation. Ignored for non-api_key token types.
  scopes String[] @default([])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  // The single `(token_hash)` index from the init migration was replaced
  // with two type-partitioned indexes in
  // 20260512100000_db_hardening_constraints: a partial UNIQUE for
  // `type = 'refresh'` and a partial non-unique for `type =
  // 'magic_link'`. Both live in SQL only because Prisma cannot model
  // partial indexes.
  @@index([familyId])
  @@map("auth_tokens")
}

model Team {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(255)
  key            String  @db.VarChar(10)
  displayName    String  @map("display_name") @db.VarChar(255)
  description    String?
  icon           String? @db.VarChar(255)
  color          String? @db.VarChar(7)
  private        Boolean @default(false)

  // Hierarchy
  parentId String? @map("parent_id") @db.Uuid

  // Timezone
  timezone String @default("UTC") @db.VarChar(63)

  // Cycle configuration (used in Sprint 15-16)
  cyclesEnabled            Boolean @default(false) @map("cycles_enabled")
  cycleDuration            Int?    @default(2) @map("cycle_duration")
  cycleCooldownTime        Int?    @default(0) @map("cycle_cooldown_time")
  cycleStartDay            Int?    @default(1) @map("cycle_start_day")
  cycleLockToActive        Boolean @default(false) @map("cycle_lock_to_active")
  cycleAutoAssignStarted   Boolean @default(false) @map("cycle_auto_assign_started")
  cycleAutoAssignCompleted Boolean @default(false) @map("cycle_auto_assign_completed")
  // Plan-tier cap: how many upcoming cycles autoCreateUpcomingCycles keeps
  // pre-populated. Default matches the previously-hardcoded constant in
  // cycle.service.ts.
  upcomingCycleCount       Int     @default(15) @map("upcoming_cycle_count")

  // Auto-close/archive
  autoClosePeriod       Int?    @map("auto_close_period")
  autoCloseStateId      String? @map("auto_close_state_id") @db.Uuid
  autoArchivePeriod     Int?    @map("auto_archive_period")
  autoCloseChildIssues  Boolean @default(false) @map("auto_close_child_issues")
  autoCloseParentIssues Boolean @default(false) @map("auto_close_parent_issues")

  // Estimation
  issueEstimationType      IssueEstimationType @default(notUsed) @map("issue_estimation_type")
  issueEstimationExtended  Boolean @default(false) @map("issue_estimation_extended")
  issueEstimationAllowZero Boolean @default(false) @map("issue_estimation_allow_zero")
  defaultIssueEstimate     Float?  @map("default_issue_estimate")

  // Defaults
  defaultIssueStateId String? @map("default_issue_state_id") @db.Uuid
  triageEnabled       Boolean @default(false) @map("triage_enabled")

  // Counter
  issueCount Int @default(0) @map("issue_count")

  // Lifecycle
  joinByDefault Boolean   @default(false) @map("join_by_default")
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                 Team?                   @relation("TeamHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Team[]                  @relation("TeamHierarchy")
  memberships            TeamMembership[]
  workflowStates         WorkflowState[]         @relation("TeamWorkflowStates")
  defaultIssueState      WorkflowState?          @relation("TeamDefaultIssueState", fields: [defaultIssueStateId], references: [id], onDelete: SetNull)
  autoCloseState         WorkflowState?          @relation("TeamAutoCloseState", fields: [autoCloseStateId], references: [id], onDelete: SetNull)
  issues                 Issue[]
  labels                 IssueLabel[]
  projectTeams           ProjectTeam[]
  cycles                 Cycle[]
  customViews            CustomView[]
  issueTemplates         IssueTemplate[]
  memberRoles            TeamMemberRole[]
  customFieldDefinitions CustomFieldDefinition[]
  documents              Document[]
  automationRules        AutomationRule[]
  webhooks               Webhook[]
  slackDefaultFor        SlackIntegration[]     @relation("SlackDefaultTeam")

  // Unique on (organizationId, key) is enforced via a partial index in the DB
  // (WHERE archived_at IS NULL) so archived teams don't block key reuse.
  @@index([organizationId, key])
  @@index([organizationId])
  @@index([parentId])
  // Index the FK referencing columns so deletes/updates of a WorkflowState
  // don't seq-scan teams to find dependents. Without these, PG falls back
  // to a full table scan on every workflow_states delete (which the FK's
  // ON DELETE SET NULL has to evaluate).
  @@index([defaultIssueStateId])
  @@index([autoCloseStateId])
  @@map("teams")
}

model TeamMembership {
  id        String  @id @default(uuid()) @db.Uuid
  teamId    String  @map("team_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  isOwner   Boolean @default(false) @map("is_owner")
  sortOrder Float   @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_memberships")
}

model WorkflowState {
  id          String  @id @default(uuid()) @db.Uuid
  teamId      String  @map("team_id") @db.Uuid
  name        String  @db.VarChar(255)
  color       String  @db.VarChar(7)
  description String?
  type        WorkflowStateType
  position    Float   @default(0)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  team              Team    @relation("TeamWorkflowStates", fields: [teamId], references: [id], onDelete: Cascade)
  issues            Issue[]
  defaultForTeams   Team[]  @relation("TeamDefaultIssueState")
  autoCloseForTeams Team[]  @relation("TeamAutoCloseState")

  @@index([teamId])
  @@index([teamId, type])
  @@map("workflow_states")
}

model Issue {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  teamId              String   @map("team_id") @db.Uuid
  number              Int
  identifier          String   @db.VarChar(20)
  previousIdentifiers String[] @default([]) @map("previous_identifiers")

  // Content
  title            String  @db.VarChar(1000)
  description      String?
  descriptionState Bytes?  @map("description_state")

  // Properties
  priority          Int       @default(0) @db.SmallInt
  estimate          Float?
  startDate         DateTime? @map("start_date") @db.Date
  dueDate           DateTime? @map("due_date") @db.Date
  sortOrder         Float     @default(0) @map("sort_order")
  prioritySortOrder Float     @default(0) @map("priority_sort_order")
  subIssueSortOrder Float?    @map("sub_issue_sort_order")

  // Relationships
  stateId            String  @map("state_id") @db.Uuid
  assigneeId         String? @map("assignee_id") @db.Uuid
  creatorId          String? @map("creator_id") @db.Uuid
  parentId           String? @map("parent_id") @db.Uuid
  projectId          String? @map("project_id") @db.Uuid
  projectMilestoneId String? @map("project_milestone_id") @db.Uuid
  cycleId            String? @map("cycle_id") @db.Uuid

  // Git
  branchName String? @map("branch_name") @db.VarChar(500)

  // SLA
  slaBreachesAt   DateTime? @map("sla_breaches_at") @db.Timestamptz
  slaHighRiskAt   DateTime? @map("sla_high_risk_at") @db.Timestamptz
  slaMediumRiskAt DateTime? @map("sla_medium_risk_at") @db.Timestamptz
  slaStartedAt    DateTime? @map("sla_started_at") @db.Timestamptz
  slaType         String?   @map("sla_type") @db.VarChar(50)

  // Lifecycle timestamps
  startedAt        DateTime? @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  canceledAt       DateTime? @map("canceled_at") @db.Timestamptz
  autoArchivedAt   DateTime? @map("auto_archived_at") @db.Timestamptz
  autoClosedAt     DateTime? @map("auto_closed_at") @db.Timestamptz
  startedTriageAt  DateTime? @map("started_triage_at") @db.Timestamptz
  triagedAt        DateTime? @map("triaged_at") @db.Timestamptz
  addedToCycleAt   DateTime? @map("added_to_cycle_at") @db.Timestamptz
  addedToProjectAt DateTime? @map("added_to_project_at") @db.Timestamptz

  // Soft delete / snooze
  trashed        Boolean   @default(false)
  snoozedById    String?   @map("snoozed_by_id") @db.Uuid
  snoozedUntilAt DateTime? @map("snoozed_until_at") @db.Timestamptz

  // Metadata
  reactionData        Json @default("{}") @map("reaction_data")
  customerTicketCount Int  @default(0) @map("customer_ticket_count")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  // organization/team/state intentionally keep the default RESTRICT (not
  // Cascade). Issues are never hard-deleted in normal operation — they soft
  // delete via `archivedAt`/`trashed`. RESTRICT means a Team or Organization
  // cannot be hard-deleted while issues exist, which is the desired guard:
  // it prevents an accidental team delete from silently wiping every issue.
  // A deliberate org/team purge must delete issues (and their state refs) in
  // dependency order first; there is no implicit cascade by design.
  // Cascade on org/team delete to match peer models (Project, Cycle, which
  // already Cascade). Without it, deleting an org/team with issues errored on
  // the default Restrict while its projects cascaded — inconsistent semantics.
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team              Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  state             WorkflowState              @relation(fields: [stateId], references: [id])
  assignee          User?                      @relation("AssignedIssues", fields: [assigneeId], references: [id])
  creator           User?                      @relation("CreatedIssues", fields: [creatorId], references: [id])
  snoozedBy         User?                      @relation("SnoozedIssues", fields: [snoozedById], references: [id])
  parent            Issue?                     @relation("SubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children          Issue[]                    @relation("SubIssues")
  labelAssignments  IssueLabelAssignment[]
  activities        IssueActivity[]
  cycle             Cycle?                     @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  project           Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectMilestone  ProjectMilestone?          @relation(fields: [projectMilestoneId], references: [id], onDelete: SetNull)
  subscriptions     NotificationSubscription[]
  issueRelations    IssueRelation[]            @relation("IssueRelations")
  relatedToIssues   IssueRelation[]            @relation("RelatedIssues")
  files             File[]
  comments          Comment[]
  customFieldValues CustomFieldValue[]
  pullRequests      GitHubPullRequest[]
  reactions         IssueReaction[]

  @@unique([teamId, number])
  @@index([organizationId])
  @@index([teamId])
  @@index([stateId])
  @@index([assigneeId])
  @@index([cycleId])
  @@index([parentId])
  @@index([identifier])
  @@index([teamId, priority])
  @@index([teamId, createdAt])
  // §2.1 DB hardening — compound/anchored indexes for hot list paths. The
  // org-anchored (org, updated_at DESC) replaces the un-anchored (updated_at)
  // single index (every issue read is org-scoped); (project_id, archived_at,
  // trashed) replaces the bare (project_id) it prefixes, serving Project.issues.
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([assigneeId, stateId])
  @@index([projectId, archivedAt, trashed])
  // GIN index over the previous-identifier history array. Load-bearing:
  // `IssueService.findByIdentifier` falls back to a `previousIdentifiers`
  // lookup (OR clause) and `GithubService.linkPullRequest` matches with
  // `hasSome`, so renamed issues stay reachable by their old key (e.g. a
  // team-key change moving ENG-123 → PLAT-123). Do not drop. Writes to
  // `previousIdentifiers` happen only on team-key renames.
  @@index([previousIdentifiers], type: Gin)
  @@map("issues")
}

