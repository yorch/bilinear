model SyncAction {
  id             BigInt @id @default(autoincrement())
  organizationId String @map("organization_id") @db.Uuid
  // I=Insert, U=Update, D=Delete, A=Archive
  action         String @db.VarChar(1)
  modelName      String @map("model_name") @db.VarChar(50)
  modelId        String @map("model_id") @db.Uuid
  data           Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  // Commit-order fence for delta sync. `pg_current_xact_id()` stamps every
  // insert with the writing transaction's 64-bit transaction id (xid8, no
  // wraparound). Delta reads order by `(xactId, id)` AND fence on
  // `xact_id < pg_snapshot_xmin(pg_current_snapshot())`, so a row is served
  // only once its transaction has SETTLED and no smaller-xid transaction is
  // still in flight below the cursor. This is provably never-skip: unlike the
  // former `committed_at = statement_timestamp()` + wall-clock safety window,
  // a transaction that inserts early and commits arbitrarily later can no
  // longer be missed — its xid keeps it fenced until it actually commits,
  // regardless of elapsed time. The `xid8` column + `pg_current_xact_id()`
  // default are Prisma-expressible (an `Unsupported` type with a
  // `dbgenerated` default), so they live in the generated `00000000000000_init`
  // baseline; only the `(organization_id, xact_id, id)` covering index — which
  // Prisma can't declare on an `Unsupported` field — lives in the custom
  // migration `00000000000001_custom_constraints_and_triggers`. `Unsupported`
  // means the field is not selectable through the Prisma client — it is read
  // only via the raw SQL in `SyncService` (see `getDeltaSyncActions`). Required
  // (not `?`) so it matches the NOT NULL column; the `dbgenerated` default keeps
  // it out of the Prisma create input.
  xactId Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("xact_id")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, id])
  @@index([createdAt])
  // §2.1 — targeted SyncAction lookup by (org, model, id) for replay/debug.
  @@index([organizationId, modelName, modelId])
  @@map("sync_actions")
}

