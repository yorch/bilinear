/// Custom field definition. Scoped to a team (`teamId` non-null) OR to the
/// whole workspace (`teamId` null) — workspace-scoped definitions surface on
/// every team in the org. `options` holds `[{ value, label, color? }]` for
/// select/multi_select types; null for other types.
model CustomFieldDefinition {
  id             String          @id @default(uuid()) @db.Uuid
  // Nullable for workspace-scope. When null the definition applies to
  // every team in the org; organizationId is the tenant guard in that case
  // (looked up via the parent team for team-scoped rows).
  teamId         String?         @map("team_id") @db.Uuid
  // organizationId is denormalised so the workspace-scoped lookup
  // (teamId IS NULL) has a clean tenant filter; for team-scoped rows it
  // mirrors team.organizationId.
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(255)
  type           CustomFieldType
  description    String?
  required       Boolean         @default(false)
  options        Json?
  sortOrder      Float           @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz

  team         Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@index([teamId])
  @@index([organizationId])
  @@map("custom_field_definitions")
}

/// One row per (issueId, definitionId) holding the typed JSON value.
/// Value shape by type: text/url → string, number → number, date → ISO date string,
