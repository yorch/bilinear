DATABASE_URL=postgresql://user:pass@localhost:5432/bilinear

REDIS_URL=redis://localhost:6379
# Redis has no password — network isolation is the access control. In
# production, use docker-compose.traefik.yml which closes the redis port
# (ports: !reset []) so it is reachable only on the internal Docker network.
# Do NOT set a password in REDIS_URL: the container has no requirepass and
# clients sending AUTH will fail with "called without any password configured".

# Must be at least 32 bytes for HS256. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID). Powers the "Continue with Google" login. Register the
# redirect URI below as an "Authorized redirect URI" on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI for Google login. Defaults to <APP_URL>/auth/google/callback
# when unset. The server drives the exchange with this value — clients cannot
# override it — so it must exactly match one of the "Authorized redirect URIs"
# registered in Google Cloud Console.
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# GitHub OAuth App (Settings → Developer settings → OAuth Apps). Used for
# BOTH "Continue with GitHub" login and the org integration connect flow.
# Register the app's Authorization callback URL as <APP_URL> (the root) so
# both redirect paths below are valid subdirectories of it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Redirect URI for GitHub *login* (not the integration). Defaults to
# <APP_URL>/auth/github/callback when unset.
# GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Slack app (api.slack.com/apps). Enables the /bilinear slash command and
# connect flow at Settings → Integrations. The signing secret is app-level
# (verifies slash requests); the bot token is per-install and stored per org.
# Configure the slash command request URL to <APP_URL>/api/integrations/slack/commands
# and the OAuth redirect URL to <APP_URL>/api/integrations/slack/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# Set to "1" only when the app sits behind a proxy/edge that strips or
# overwrites client-supplied forwarding headers (Vercel, Cloudflare,
# reverse-proxy with trusted forwarded). Required for per-IP auth rate
# limiting to work correctly; leave unset on direct-exposure deployments.
TRUST_PROXY_HEADERS=

# Local dev: use Mailpit (docker-compose.infra.yaml) — no auth needed
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Set to "true" to force TLS (port 465). For STARTTLS (port 587) leave unset — nodemailer handles it automatically.
SMTP_SECURE=

# Production: fill all fields with your SMTP provider credentials
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_SECURE=false  # true for port 465, false/unset for port 587 STARTTLS

APP_URL=http://localhost:3000

# --- Branding ---
# Display name shown in the UI, page titles, and transactional emails.
# NEXT_PUBLIC_* is inlined at BUILD time, so set it before `yarn build`.
# Defaults to "Bilinear" when unset.
# NEXT_PUBLIC_APP_NAME=Bilinear

# --- Real-time sync WebSocket server (yarn ws:server) ---
# Port the standalone WS server listens on (handles real-time sync fan-out,
# the webhook retry sweep, and cycle auto-rollover). Must run as its own
# process — it is not started by `node server.js` / the app container.
# WS_PORT=3001
#
# Public endpoint the BROWSER uses to reach the WS server. Read at REQUEST
# time and handed to the client by /api/auth/ws-ticket, so unlike the
# NEXT_PUBLIC_* vars below it works with a prebuilt image — no rebuild needed.
# Accepts a same-origin path, an absolute URL, or a bare host:
#   /ws                      -> wss://<your-domain>/ws   (behind a reverse
#                               proxy; needs no second port or certificate,
#                               and is what docker-compose.traefik.yml sets up)
#   wss://rt.example.com     -> used verbatim
#   ws://localhost:3001      -> used verbatim (local/no-TLS deployments)
# Leave unset to keep the legacy <page-hostname>:<NEXT_PUBLIC_WS_PORT> behavior.
# NOTE: a browser on an https:// page cannot open a ws:// socket, and wss://
# to a raw port requires TLS on that port. If your proxy only terminates TLS
# on :443, use the path form.
# WS_PUBLIC_URL=/ws
#
# Build-time fallbacks, used only when WS_PUBLIC_URL is unset. NEXT_PUBLIC_* is
# inlined at BUILD time, so these must be set before `yarn build`.
# NEXT_PUBLIC_WS_PORT=3001
# NEXT_PUBLIC_WS_URL=/ws

# --- GraphQL / security ---
# Comma-separated extra Origins allowed to call /api/graphql (in addition to
# APP_URL). Leave unset to allow only APP_URL.
# GRAPHQL_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Allow webhook delivery to private/loopback/link-local IPs. NEVER enable in
# production — it disables the SSRF guard. Useful only for local webhook
# testing against a service on the same host.
# ALLOW_PRIVATE_WEBHOOK_URLS=
# Opt the unauthenticated auth-mutation rate limiter (login / magic-link
# verify) into fail-CLOSED on a Redis outage. Default (unset) is fail-open so
# an outage doesn't block login; set to "1" to instead reject auth attempts
# when Redis is unreachable, preserving brute-force protection on the 6-digit
# verify code at the cost of login availability during the outage.
# AUTH_RATE_LIMIT_FAIL_CLOSED=

# --- AI assistant ---
# Enables AI features (title suggestion, summarize, duplicate detection).
# Requires BOTH a configured provider key below AND the per-workspace toggle
# (Settings → AI). Select the backend with AI_PROVIDER (default: anthropic).
# AI_PROVIDER=anthropic    # anthropic | openai
#
# Anthropic Messages API (default provider):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=         # default: claude-haiku-4-5-20251001
# ANTHROPIC_BASE_URL=      # default: https://api.anthropic.com (no /v1)
#
# OpenAI-compatible Chat Completions (set AI_PROVIDER=openai). Point
# OPENAI_BASE_URL at any compatible endpoint (OpenAI, Azure, OpenRouter,
# Together, Ollama/LM Studio, …).
# OPENAI_API_KEY=
# OPENAI_MODEL=            # default: gpt-4o-mini
# OPENAI_BASE_URL=         # default: https://api.openai.com/v1

# --- Runtime configuration (src/lib/config/registry.ts) ---
# Most operational knobs now live in a configuration registry backed by the
# `settings` table and edited at /admin/config. The environment variables below
# still work: each is a LAYER beneath any stored value, so setting one changes
# the default for anyone who has not configured the knob explicitly.
#
# WEBHOOK_MAX_ATTEMPTS=5           # delivery attempts before a webhook fails
# WEBHOOK_AUTO_DISABLE_AFTER=20    # consecutive failures before auto-disable
# WEBHOOK_REQUEST_TIMEOUT_MS=10000
#
# A few knobs are deliberately environment-only and can never be stored:
# secrets, boot-time values, and the security guards below. See §5 of
# docs/CONFIG_ASSESSMENT.md — a database-storable SSRF kill switch would let a
# compromised admin session disable the guard with a mutation.

# --- Logging (pino) ---
# LOG_LEVEL=info          # trace|debug|info|warn|error|fatal
# LOG_PRETTY=             # set to "1" for pretty (pino-pretty) dev output
# LOG_HTTP_SAMPLE_RATE=1  # 0..1 fraction of successful GraphQL requests to access-log
                          # (server-side errors and slow requests are always logged;
                          #  blank is treated as unset → default 1)

# YJS collaborative editing server (yarn yjs:server, default port 1234)
# YJS_PORT=1234
#
# Multi-cursor collaborative editing. These three belong together — enabling
# the feature without running the server (or vice versa) is the one way to get
# a broken editor:
#   1. COLLAB_ENABLED=true      turns the feature on in the UI
#   2. YJS_PUBLIC_URL=/collab   tells the browser where to reach the server
#   3. COMPOSE_PROFILES=collab  actually starts the `yjs` container
# Both COLLAB_ENABLED and YJS_PUBLIC_URL are read at REQUEST time, so unlike
# the NEXT_PUBLIC_* spellings below they work with a prebuilt image.
# YJS_PUBLIC_URL takes the same shapes as WS_PUBLIC_URL above (path, absolute
# URL, or bare host); a reverse proxy routing the path must NOT strip it.
# COLLAB_ENABLED=true
# YJS_PUBLIC_URL=/collab
# COMPOSE_PROFILES=collab
#
# Build-time fallbacks, used only when the runtime vars above are unset.
# NEXT_PUBLIC_COLLAB_ENABLED=true
# NEXT_PUBLIC_YJS_SERVER_URL=ws://localhost:1234

# Directory for uploaded file attachments (default: ./uploads relative to cwd)
# UPLOAD_DIR=/var/data/uploads

# --- Environment & runtime ---
# NODE_ENV defaults to development. Never set to 'production' in .env or for local dev.
# NODE_ENV=development
#
# NEXT_RUNTIME is set BY Next.js, not by you. It is read in
# src/instrumentation.ts to pick which Sentry config to load. Listing it as an
# input here previously invited someone to set it wrongly.
#
# DEBUG, NO_COLOR, PRISMA_CLIENT_GET_TIME and PRISMA_DISABLE_WARNINGS used to be
# documented here as if they were app settings. They are third-party library
# variables that this application never reads, so they have been removed rather
# than left as noise in the one file operators are told to read.

# --- Testing (E2E) ---
# TEST_AUTH_CODE enables E2E login bypass. NEVER set in production (NODE_ENV !== production).
# When set, users can verify magic-link codes by entering this value instead of the real code.
# Only effective when NODE_ENV=test. Security: this completely disables login verification.
# TEST_AUTH_CODE=000000

# Sentry (optional error tracking). NEXT_PUBLIC_SENTRY_DSN is inlined at BUILD
# time (like every NEXT_PUBLIC_* variable), so it must be set before
# `yarn build` / `docker build`; setting it on a prebuilt image does nothing
# for the browser SDK. SENTRY_DSN is read at runtime by the server/edge SDKs.
# SENTRY_AUTH_TOKEN/ORG/PROJECT are consumed only by `next build` for source
# map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Dev tooling: `yarn analyze` sets ANALYZE=true to open the bundle analyzer.
# ANALYZE=

# --- Docker deploy ---
# Consumed by docker-compose, NOT by the application itself.
# WS_PORT_PUBLISHED=3001        # host port published for the WS container
# YJS_PORT_PUBLISHED=1234       # host port published for the Yjs container
# APP_IMAGE=ghcr.io/yorch/bilinear:main
# APP_PORT=3000                  # host port (set to change the external port)
# DATABASE_URL_OVERRIDE=         # optional: managed DB URL overrides compose service
# DOMAIN_APP=                    # domain for the app (used by Traefik)
# POSTGRES_DB=bilinear
# POSTGRES_PASSWORD=pass
# POSTGRES_USER=user
# TRAEFIK_NAME=bilinear          # service name label for Traefik
# WATCHTOWER_POLL_INTERVAL=300   # seconds between watchtower polls
# WATCHTOWER_SCOPE=bilinear      # scope name for watchtower labeling
