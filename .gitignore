# ── Dependencies ────────────────────────────────────────────────
# Bower dependency directory (https://bower.io/)
bower_components
# Dependency directories
node_modules/
# yarn v4 (non-zero-installs)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
# Python bytecode cache (scripts/*.py codemods)
__pycache__/

# ── Build output ────────────────────────────────────────────────
# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release
# TypeScript cache
*.tsbuildinfo
# Next.js build output
.next
# Prisma generated client (run `prisma generate` after checkout)
src/generated/
dist
# Sveltekit cache directory
.svelte-kit/

# ── Env files ───────────────────────────────────────────────────
# Ignore every env file except the committed examples.
# `.env.*` does not match `.env` itself, hence both lines; the negations come
# last so they win regardless of what appears above.
.env
.env.*
!.env.example
!.env.*.example

# ── Local infra state ───────────────────────────────────────────
# Local infra volumes created by `docker:infra:up` (root-owned).
# Anchored to the repo root so it never shadows a source dir named `data`.
/data/

# ── Editor / IDE ────────────────────────────────────────────────
# Share project editor config; ignore everything else the editor writes.
# Stores VSCode versions used for testing VSCode extensions
.vscode-test
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ── Logs & caches ───────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Optional eslint cache
.eslintcache
# dotenv environment variable files
# parcel-bundler cache (https://parceljs.org/)
.parcel-cache
# Gatsby files
.cache/
.cache

# ── Testing & coverage ──────────────────────────────────────────
# Coverage directory used by tools like istanbul
coverage
# nyc test coverage
.nyc_output
# Playwright
playwright-report/
test-results/

# ── Project-specific ────────────────────────────────────────────
logs
lerna-debug.log*
# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
# Runtime data
pids
*.pid
*.seed
*.pid.lock
# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov
*.lcov
# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt
# node-waf configuration
.lock-wscript
jspm_packages/
# Snowpack dependency directory (https://snowpack.dev/)
web_modules/
# Optional npm cache directory
.npm
# Optional stylelint cache
.stylelintcache
# Optional REPL history
.node_repl_history
# Output of 'npm pack'
*.tgz
# Yarn Integrity file
.yarn-integrity
out
# Next.js generated type file (regenerated on every build)
next-env.d.ts
# Nuxt.js build / generate output
.nuxt
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public
# vuepress build output
.vuepress/dist
# vuepress v2.x temp and cache directory
.temp
# vitepress build output
**/.vitepress/dist
# vitepress cache directory
**/.vitepress/cache
# Docusaurus cache and generated files
.docusaurus
# Serverless directories
.serverless/
# FuseBox cache
.fusebox/
# DynamoDB Local files
.dynamodb/
# Firebase cache directory
.firebase/
# TernJS port file
.tern-port
# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# AI
.claude/settings.local.json
# Redis
dump.rdb
.claude/worktrees/
# We use yarn.lock
package-lock.json
*.pyc
